# API server port (Hono / Bun)
PORT=3100

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/kyra

# JWT Secret (change in production!)
JWT_SECRET=your-secret-key-here

# Vercel: disable built-in request helpers (required for Hono)
NODEJS_HELPERS=0

# Storage (S3-compatible — works with Supabase Storage, AWS S3, Cloudflare R2, MinIO, etc.)
STORAGE_ENDPOINT=https://xxx.supabase.co/storage/v1/s3
STORAGE_REGION=auto
STORAGE_BUCKET=images
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_PUBLIC_URL=https://xxx.supabase.co/storage/v1/object/public/images

# Stripe (used by Administrative > Invoices/Billings sync)
STRIPE_API_KEY=sk_live_or_test_key
